# Chave da API da Anthropic usada pelo servidor para gerar os resumos.
ANTHROPIC_API_KEY=

# Porta do servidor e pasta onde ficam o banco SQLite e os arquivos enviados.
PORT=3001
DATA_DIR=./data

# Endereço público do app (usado no link do e-mail de redefinição de senha).
# No Render e no Railway é detectado automaticamente; em outros lugares, preencha.
# APP_URL=https://resumi.seudominio.com

# Envio de e-mails (recuperação de senha). Sem isso, em desenvolvimento o link aparece no terminal.
# Ex.: smtps://usuario:senha-de-app@smtp.gmail.com:465
SMTP_URL=
MAIL_FROM=Resumi <nao-responda@seudominio.com>
